# Go API base URL (portfolio-api). Public: used by the browser (admin) and server.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Optional server-only override, e.g. a private network URL for SSR/ISR fetches.
# API_INTERNAL_BASE_URL=

# Comma-separated origins allowed to serve images (API uploads in dev,
# Cloudflare R2 public URL / custom domain in production).
NEXT_PUBLIC_IMAGE_ORIGINS=http://localhost:8080

# Canonical site URL (sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Formspree form id to enable the contact form (e.g. xyzabcd).
NEXT_PUBLIC_FORMSPREE_ID=

# Server-only. Shared with portfolio-api so it can trigger instant
# revalidation after content changes (POST /api/revalidate).
REVALIDATE_SECRET=
